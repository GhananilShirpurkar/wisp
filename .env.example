# Linux: run npm run ui, then Screen sharing > Choose a screen.
# Set PAPERCLIP_DEMO=0 and PAPERCLIP_CAPTURE=1 below for live vision.
PAPERCLIP_CAPTURE=0
PAPERCLIP_DEMO=1
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=gemma4:e2b
TEMPORAL_ADDRESS=127.0.0.1:7233
CONTINUE_AFTER_MINUTES=60
STUCK_MINUTES=20
HAUNT_UNTIL_HOUR=5
# Optional, off by default. Only allowlisted metric spans are exported.
SENTRY_DSN=
